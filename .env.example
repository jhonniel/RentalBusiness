# Application
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME=JRY Rentals

# Do not use the word "placeholder" in live secrets. Health reports ready=false until
# Supabase, service-role, CRON_SECRET, PAYMENT_WEBHOOK_SECRET, and Gmail SMTP are set.

# Supabase (public — safe for the browser)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias used by @nuxtjs/supabase
NUXT_PUBLIC_SUPABASE_KEY=

# Supabase (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP (server only — use an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JRY Rentals <you@gmail.com>
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=JRY Rentals <you@gmail.com>

# Payments (server only — provider-agnostic)
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=
NUXT_PAYMENT_PROVIDER_KEY=
NUXT_PAYMENT_WEBHOOK_SECRET=

# Scheduled jobs (server only)
CRON_SECRET=
NUXT_CRON_SECRET=
